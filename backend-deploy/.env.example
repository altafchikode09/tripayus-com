# ==========================================
# TRIPAY AI — PRODUCTION ENVIRONMENT
# ==========================================

# Database (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://tripay:CHANGE_THIS_PASSWORD@postgres:5432/tripay_db?schema=public"

# JWT Authentication
# Generate a strong secret: openssl rand -base64 32
JWT_SECRET="your-super-secret-jwt-key-change-this-immediately-32chars"
JWT_EXPIRES_IN="7d"

# Application
NODE_ENV=production
PORT=3001
FRONTEND_URL="https://yourdomain.com"

# File Uploads
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE=52428800

# Redis (for BullMQ / background jobs)
REDIS_URL="redis://redis:6379"

# Email (optional — for notifications)
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASS=your_sendgrid_key
# FROM_EMAIL=noreply@yourdomain.com
